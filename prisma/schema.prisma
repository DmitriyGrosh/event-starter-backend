// This is your Prisma schema file

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets   = ["native", "linux-musl-arm64-openssl-3.0.x"]
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int       @id @default(autoincrement())
  name              String
  email             String    @unique
  password          String
  createdAt         DateTime  @default(now()) @map("created_at")
  ownedEvents       Event[]   @relation("EventOwner")
  eventSubscriptions EventSubscription[]
  ticketPurchases   TicketPurchase[]

  @@map("users")
}

model Event {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  location    String?   // Made optional to handle existing events
  dateStart   DateTime  @map("date_start")
  dateEnd     DateTime  @map("date_end")
  createdAt   DateTime  @default(now()) @map("created_at")
  owner       User      @relation("EventOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     Int       @map("owner_id")
  subscribers EventSubscription[]
  tickets     Ticket[]
  tags        EventTag[]

  @@map("events")
}

model EventSubscription {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int      @map("user_id")
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   Int      @map("event_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, eventId])
  @@map("event_subscriptions")
}

model Ticket {
  id          Int       @id @default(autoincrement())
  name        String    // e.g., "VIP", "Early Bird", "Regular"
  description String?
  price       Decimal   @db.Decimal(10, 2)
  quantity    Int       // Total available tickets of this type
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId     Int       @map("event_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  purchases   TicketPurchase[]

  @@map("tickets")
}

model TicketPurchase {
  id        Int      @id @default(autoincrement())
  quantity  Int      // Number of tickets purchased
  totalPaid Decimal  @db.Decimal(10, 2)
  status    String   // "PENDING", "COMPLETED", "CANCELLED", "REFUNDED", "TRANSFERRED"
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  ticketId  Int      @map("ticket_id")
  user      User     @relation(fields: [userId], references: [id])
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  transfersFrom TicketTransfer[] @relation("TransferFrom")
  transfersTo   TicketTransfer[] @relation("TransferTo")

  @@map("ticket_purchases")
}

model TicketTransfer {
  id            Int            @id @default(autoincrement())
  fromPurchase  TicketPurchase @relation("TransferFrom", fields: [fromPurchaseId], references: [id])
  fromPurchaseId Int           @map("from_purchase_id")
  toPurchase    TicketPurchase @relation("TransferTo", fields: [toPurchaseId], references: [id])
  toPurchaseId   Int           @map("to_purchase_id")
  quantity      Int            // Number of tickets being transferred
  status        String         // "PENDING", "COMPLETED", "CANCELLED"
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@map("ticket_transfers")
}

model Tag {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  events      EventTag[]

  @@map("tags")
}

model EventTag {
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId     Int      @map("event_id")
  tag         Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId       Int      @map("tag_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@id([eventId, tagId])
  @@map("event_tags")
}
